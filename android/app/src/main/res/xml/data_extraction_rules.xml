<?xml version="1.0" encoding="utf-8"?>
<!--
  允许备份规则：账号 Cookie 属于登录凭据，任何云备份 / adb backup
  都可能导致凭据外泄，因此全部排除。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
