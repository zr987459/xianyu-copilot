# 模型协议类型: anthropic 或 openai
API_TYPE=anthropic

# 您的 API Key
API_KEY=your_api_key_here

# 模型接口 Base URL
MODEL_BASE_URL=https://api.anthropic.com

# 模型名称
MODEL_NAME=claude-3-5-sonnet-20241022

# 闲鱼网页端抓取的 Cookie 字符串
COOKIES_STR=your_goofish_cookie_here

# 服务运行端口
PORT=9005

# 人工接管触发词
TOGGLE_KEYWORDS=。
SIMULATE_HUMAN_TYPING=True

# 管理口令：所有 /api/* 需要它。生成：python3 -c "import secrets;print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=
# 监听地址：默认仅本机；改成 0.0.0.0 前必须配置 ADMIN_TOKEN
HOST=127.0.0.1
# 跨域来源（逗号分隔），同源访问留空
ALLOW_ORIGINS=
