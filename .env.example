# 模型协议类型: anthropic 或 openai
API_TYPE=anthropic

# 您的 API Key
API_KEY=your_api_key_here

# 模型接口 Base URL
MODEL_BASE_URL=https://api.anthropic.com

# 模型名称
MODEL_NAME=claude-3-5-sonnet-20241022

# 闲鱼网页端抓取的 Cookie 字符串
COOKIES_STR=your_goofish_cookie_here

# 服务运行端口
PORT=9005

# 人工接管触发词
TOGGLE_KEYWORDS=。
SIMULATE_HUMAN_TYPING=True

# 管理后台访问令牌（必填，至少 32 位随机串，可用: python -c "import secrets;print(secrets.token_urlsafe(32))"）
ADMIN_TOKEN=
# 监听地址：默认仅本机；局域网/公网访问请改 0.0.0.0 并务必配置 ADMIN_TOKEN + HTTPS 反代
HOST=127.0.0.1
# 允许跨域的前端来源（同源部署留空）
CORS_ORIGINS=
