# 模型协议类型: anthropic 或 openai
API_TYPE=anthropic

# 您的 API Key
API_KEY=your_api_key_here

# 模型接口 Base URL
MODEL_BASE_URL=https://api.anthropic.com

# 模型名称
MODEL_NAME=claude-3-5-sonnet-20241022

# 闲鱼网页端抓取的 Cookie 字符串
COOKIES_STR=your_goofish_cookie_here

# 服务运行端口
PORT=9005

# 人工接管触发词
TOGGLE_KEYWORDS=。
SIMULATE_HUMAN_TYPING=True

# 后台访问令牌（所有 /api/* 必须携带 Authorization: Bearer <ADMIN_TOKEN>）
# 不设置时每次启动随机生成并打印到控制台。请用足够长的随机串，例如: python -c "import secrets;print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# 仅在需要跨域访问时填写，逗号分隔；默认同源
CORS_ORIGINS=

# AI 最多让价轮数（前端议价状态条使用）
BARGAIN_MAX_ROUNDS=3
